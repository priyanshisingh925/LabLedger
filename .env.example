# Copy to .env if you need to override defaults. NEVER put real private keys here.
# RPC URL of the local Hardhat node
LOCAL_RPC_URL=http://127.0.0.1:8545

# Loan policy used by scripts/deploy.ts (seconds / basis points). Short values make the demo quick.
LOAN_DURATION_SECONDS=120
PENALTY_PERIOD_SECONDS=60
LATE_FEE_BPS=1000

# Optional comma-separated student wallet addresses to authorize in seed.ts
# (defaults to Hardhat accounts #1 and #2)
# STUDENT_ADDRESSES=0x...,0x...
